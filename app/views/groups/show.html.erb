<%= content_for(:canonical_link, university_group_url(@university.url, @group)) %>

<div data-university-url="<%= @university.url %>"></div>
<div data-type="groups"></div>
<div data-id="<%= @group.id %>"></div>
<div data-pair-date="<%= @pair_date %>"></div>

<%= javascript_pack_tag 'records' %>

<% meta_tag :description, "Інформація про групу - " + @group.name %>
<% @title = @group.name %>
<% no_index %>

<%= render "layouts/navbar", university: @university %>
<p id="notice"><%= notice %></p>

<main class="container" role="main">

  <div class="mx-auto col-md-8 mt-4">
    <table>
      <tbody>
        <tr>
          <td class="align-baseline"><h1><%= @group.name %></h1></td>
          <% if @group.university.show_info %>
          <td class="align-top">
            <%= link_to info_university_group_url(@university.url, @group), rel: 'nofollow' do %>
            <i class="fas fa-info-circle align-middle"></i>
            <% end %>
          </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>

  <% if !University.unavailable(@university) %>
  <%= render "layouts/datepicker", pair_date: @pair_date %>
  <% end %>
  
	<div id="spinner" class="d-flex justify-content-center min-vh-100">
		<div class="spinner-border text-primary" role="status">
			<span class="sr-only">Loading...</span>
		</div>
	</div>
	<div id="records"></div>
	<%= render "layouts/source_site" %>
</main>
<%= render "layouts/footer" %>
