<% meta_tag :description, "Інформація про групу - " + @group.name %>
<% @title = @group.name %>
<% no_index %>

<%= content_for(:canonical_link, university_group_url(@university.url, @group)) %>

<%= render "layouts/navbar", university: @university %>
<p id="notice"><%= notice %></p>

<main class="container" role="main">

  <%= render "layouts/info",
  name: @group.name,
  url: info_university_group_url(@university.url, @group),
  show_info: @university.show_info %>

  <% if !University.unavailable(@university) %>
  <%= render "layouts/datepicker", pair_date: @pair_date %>
  <% end %>
  
  <turbo-frame id="records" src="<%= university_group_url(@university.url, @group.id) %>/records?pair_date=<%= @pair_date %>">
    <div class="d-flex justify-content-center" style="height:300px;">
      <div class="spinner-grow text-primary" role="status">
        <span class="visually-hidden">Завантаження...</span>
      </div>
    </div>
  </turbo-frame>
  
</main>
<%= render "layouts/footer" %>
