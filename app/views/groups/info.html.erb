<% meta_tag :keywords, "Розклад, #{@university.short_name}, Група, #{@group.name}" %>
<% meta_tag :description, "Розклад занять #{@university.short_name}, Група " + @group.name %>
<% @title = "#{@university.short_name} - #{@group.name}" %>

<%= render "layouts/navbar", university: @university %>

<main class="container" role="main">
  <div class="mx-auto col-md-8">

    <div class="row">
      <div class="mt-4">
        <h1><%= @group.name %></h1>
        <span class="text-muted">(група)</span>
      </div>
    </div>

    <div class="row my-4">
      <div class="col-4">
        <%= link_to "Дивитися розклад", university_group_url(@university.url, @group.friendly_id), class: "btn btn-primary btn-lg", rel: "nofollow" %>
      </div>
    </div>

    <% if @group.disciplines && @group.disciplines.count > 0 %>
    <div class="row">
      <div class="col mb-4 mr-0 ml-0">
        <div class="card">
          <div class="card-header">
            <span class="ml-2">Дисципліни</span>
            <span class="text-muted">(які викладаються в цій групі)</span>
          </div>
          <ul class="list-group list-group-flush">
            <% @group.disciplines.each do |discipline| %>
            <li class="list-group-item">
              <%= link_to discipline.visible_name, university_discipline_url(@university.url, discipline.friendly_id), class: "text-decoration-none" %>
            </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
    <% end %>

    <div class="row">
      <div class="col">
        <p class="text-muted font-italic">
          Дані про дисципліни збираються автоматично, та можуть доповнюватися або змінюватися з часом.
        </p>
      </div>
    </div>

  </div>
</main>
<%= render "layouts/footer" %>
