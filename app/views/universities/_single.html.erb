<div class="card mb-3">

  <div class="card-header">
    <div class="row g-0">
      <% if !university.picture_dark.empty? %>
      <div class="col-md-auto">
        <%= link_to university_url(url: university.url) do %>
        <%= image_tag(university.picture_dark, size: "64x64", class: "align-self-center mx-2 my-2") %>
        <% end %>
      </div>
      <% end %>
      <div class="col">
        <div class="card-body">
          <h1 class="card-title"><%= university.short_name %></h1>
          <h6 class="card-subtitle mb-2 font-weight-light text-muted"><%= university.full_name %></h6>
          <% if university.is_beta %><p><span class="text-warning"> (бета-версія)</span></p><% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="card-body">
    <div class="card-text">
      <%= render "universities/university_list", university: university %>
    </div>
  </div>

  <div class="card-footer">
    <p class="text-muted font-weight-lighter"><small><%= university.description %></small></p>
  </div>
</div>
