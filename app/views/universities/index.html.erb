<% meta_tag :description, "Список навчальних закладів" %>
<% meta_tag :keywords, "Мій Університет,Розклад,Список Університетів" %>
<% @title = "Мій Університет - Всі заклади" %>
<%= content_for(:canonical_link, universities_url) %>
<% no_index %>

<%= render "layouts/header" %>

<main class="container" role="main">
  <div class="mx-auto col-md-8">
    <h1 class="mb-2">Всі заклади</h1>

    <form method="get" id="previous_date" class="row row-cols-lg-auto g-3 align-items-center my-3">

      <div class="col-auto">
        <input class="form-control mr-sm-2" type="search" placeholder="Назва" aria-label="Пошук" name="query" value="<%= @query %>" list="short-name">
        <datalist id="short-name">
          <% @all_universities.each do |university| %>
          <option value="<%= university.short_name %>"><%= university.full_name %></option>
          <% end %>
        </datalist>
      </div>

      <div class="col-auto">
        <button class="btn btn-outline-primary my-2 my-sm-0" type="submit">Шукати</button>
      </div>
    </form>

    <% if @universities.empty? %>
    <p>Нічого не знайдено</p>
    <% else %>

    <% @universities.each do |university| %>
    <div class="row mb-3">
      <div class="col col-md-10">
        <%= render "universities/single", university: university %>
      </div>
    </div>
    <% end %>

    <% end %>

    <div class="mt-4"><%= will_paginate @universities, :page_links => false, renderer: WillPaginate::ActionView::BootstrapLinkRenderer, list_classes: %w(pagination justify-content-center) %></div>

  </div>
</main>
<%= render "layouts/footer" %>
