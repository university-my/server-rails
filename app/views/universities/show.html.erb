<% meta_tag :description, "#{@university.full_name} - зручний розклад занять" %>
<% meta_tag :keywords, "Розклад,#{@university.short_name},#{@university.full_name}" %>
<%= content_for(:canonical_link, university_url(@university.url)) %>
<% @title = "Розклад #{@university.short_name} - #{I18n.l(DateTime.now, format: '%B %Y')}" %>

<%= render "layouts/header" %>

<main class="container" role="main">
  <div class="row">
    <div class="mx-auto col-md-6">
      <%= render "universities/single", university: @university %>
    </div>
  </div>
</main>
<%= render "layouts/footer" %>
