<div class="row">

  <div class="col">
    <ul class="list-group list-group-flush">

      <% if university.show_groups %>
      <li class="list-group-item">
        <%= link_to 'Групи', university_groups_url(university.url), class: "text-decoration-none" %>
      </li>
      <% end %>

      <% if university.show_teachers %>
      <li class="list-group-item">
        <%= link_to 'Викладачі', university_teachers_url(university.url), class: "ml-2 text-decoration-none" %>
      </li>
      <% end %>

      <% if university.show_classrooms %>
      <li class="list-group-item">
        <%= link_to 'Аудиторії', university_auditoriums_url(university.url), class: "ml-2 text-decoration-none" %>
      </li>
      <% end %>

    </ul>
  </div>

</div>
