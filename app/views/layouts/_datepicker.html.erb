<div class="row row-cols-lg-auto g-3 align-items-center my-3">
	<div class="col-auto">
		<%= link_to @previous_day_url, data: { turbo_frame: "_top" }, class: "btn btn-primary", style: "color: white;" do %>
		<i class="bi bi-arrow-left"></i>
		<% end %>
	</div>

	<div class="col-auto">
		<button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCalendar" aria-expanded="false" aria-controls="collapseCalendar"><i class="bi bi-calendar-event"></i></button>
	</div>

	<div class="col-auto">
		<%= link_to @next_day_url, data: { turbo_frame: "_top" }, class: "btn btn-primary", style: "color: white;" do %>
		<i class="bi bi-arrow-right"></i>
		<% end %>
	</div>	
</div>

<div class="row collapse" id="collapseCalendar">
	<div class="col-auto mb-4">
		<form action="" method="get">
			<div class="input-group" id="inputDate">
				<input type="date" id="start" name="date" value="<%= @date %>" min="<%= LessonsHelper.min_date %>" max="<%= LessonsHelper.max_date %>" class="form-control">
				<input type="submit" class="btn btn-primary" value="Дивитися">
			</div>
		</form>
	</div>
</div>
