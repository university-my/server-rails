<div class="mx-auto col-md-8 mt-4">
	<div class="mb-4">
		<h4><span class="font-weight-bold"><%= l @date, format: "%A, %e %b %Y" %></span></h4>
		<% if @university.url == 'kpi' %>
		<span>Тиждень <%= KpiService.week_for_selected_date(@date) %></span>
		<% end %>
	</div>

	<div class="container mb-3">

		<div class="row row-cols-lg-auto g-3 align-items-center my-3">
			<div class="col-auto">
				<form action="" method="get" id="previous_date">
					<input type="date" id="start" name="pair_date"
					value="<%= @previous_date %>" hidden>
					<a onclick="$('#previous_date').submit();" class="btn btn-primary" style="color: white;"><span><</span></a>
				</form>
			</div>

			<div class="col-auto">
				<button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCalendar" aria-expanded="false" aria-controls="collapseCalendar"></button>
			</div>
			
			<div class="col-auto">
				<form action="" method="get" id="next_date">
					<input type="date" id="start" name="pair_date"
					value="<%= @next_date %>" hidden>
					<a onclick="$('#next_date').submit();" class="btn btn-primary" style="color: white;"><span>></span></a>
				</form>
			</div>
		</div>

		<div class="row collapse" id="collapseCalendar">
			<div class="col-auto">
				<form action="" method="get">
					<div class="input-group" id="inputDate">
						<input type="date" id="start" name="pair_date" value="<%= @pair_date %>" min="<%= LessonsHelper.min_date %>" max="<%= LessonsHelper.max_date %>" class="form-control">
						<input type="submit" class="btn btn-primary" value="Дивитися">
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
