<% meta_tag :description, "Зручний розклад занять для навчальних закладів" %>
<% meta_tag :keywords, "Розклад,університети,пари,заняття,викладачі,студенти,аудиторії" %>
<% @title = "Мій Університет - Зручний розклад" %>

<%= render "layouts/header" %>

<div class="container">
  <div class="row mt-5">
    <div class="col-md-6 col-sm-3">
      <div class="mb-4">
        <% @universities.each do |university_group| %>
        <div class="row">
          <% university_group.each do |university| %>
          <div class="col">
            <div class="p-2">
              <a href="<%= university_url(url: university.url)%>"><img src="<%= root_url %><%= university.picture_dark %>" height="64" width="64" alt="Логотип університету <%= university.short_name %>" data-toggle="tooltip" data-placement="top" title="<%= university.full_name %>"></a>
            </div>
          </div>
          <% end %>
        </div>
        <% end %>
      </div>
    </div>
    <div class="col-md-5">
      <div class="col">

        <div class="p-2 mb-3 bg-light rounded-3">
          <div class="container-fluid py-2">
            <p class="fs-2">Маєте ідеї чи побажання?</p>
            <p class="lead fs-5">Знаєте як покращити наш сервіс? Залиште відгук!</p>
            <a class="link-primary fs-5 text-decoration-none" href="/hello" rel="nofollow">Напишіть нам</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render "layouts/footer" %>
