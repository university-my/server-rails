<%= turbo_frame_tag "records_turbo_frame" do %>

    <div class="mx-auto col-md-8 mt-2">
        <div class="mb-2">
            <h4><span class="font-weight-bold"><%= l @date, format: "%A, %e %b %Y" %></span></h4>
            <% if @university.url == 'kpi' %>
            <span>Тиждень <%= KpiService.week_for_selected_date(@date) %></span>
            <% end %>
        </div>

        <%= render "layouts/datepicker", pair_date: @date %>
    </div>
    
    <div class="px-3 py-3 mx-auto text-center col-md-6">

        <div class="row mb-4">
            <div class="col">
                <h5>Схоже, що на цю дату <span class="font-weight-bold">пар немає</span></h5>
            </div>
        </div>

        <% if defined?(next_date) && next_date.present? %>
        <div class="row mb-4">
            <div class="col">
                <div class="alert alert-secondary" role="alert">
                    <p>
                        <span class="font-weight-light">Знайдено розклад на іншу дату:</span>
                        <span class="font-weight-bold"><%= l next_date, format: "%A, %e %b %Y" %></span>
                    </p>
                    <%= link_to "Дивитися", next_date_url, data: { turbo_frame: "_top" } %>
                </div>
            </div>
        </div>
        <% end %>

        <div class="row">
            <div class="col">
                <%= image_tag LessonsHelper.random_image, class: "img-fluid", size: "250x250" %> 
                <p class="mt-3">Підписуйтеся на <b>Мій Університет</b> в <a target="_blank" href="https://t.me/university_my">Telegram</a></p>
            </div>
        </div>

    </div>
<% end %>
